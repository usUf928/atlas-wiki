# ===== 运行环境 =====
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
PUBLIC_SITE_NAME=Atlas Wiki
WEB_PORT=8080
POSTGRES_PASSWORD=atlas_dev_pw

# ===== 数据库 =====
# 开发期使用 SQLite，生产使用 PostgreSQL；同一份 schema，由 DATABASE_PROVIDER 切换
DATABASE_PROVIDER=sqlite
DATABASE_URL="file:./dev.db"
# 生产示例：
# DATABASE_PROVIDER=postgresql
# DATABASE_URL="postgresql://atlas:atlas_dev_pw@db:5432/atlas?schema=public"

# ===== 认证 =====
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
COOKIE_DOMAIN=
COOKIE_SECURE=false
CSRF_SECRET=dev_csrf_secret_change_me

# ===== 上传 =====
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=2097152

# ===== 种子账号 =====
SEED_ADMIN_PASSWORD=Admin@12345
SEED_EDITOR_PASSWORD=Editor@12345
SEED_USER_PASSWORD=User@12345
